using Gtk 4.0;
using Adw 1;

template $BootcDefaultEncryption: Adw.Bin {
  halign: fill;
  valign: fill;
  hexpand: true;

  Overlay {
    vexpand: true;
    hexpand: true;

    [overlay]
    Button btn_next {
      visible: false;
      margin-end: 12;
      margin-start: 12;
      icon-name: "go-next-symbolic";
      halign: end;
      valign: center;
      tooltip-text: _("Next");

      styles [
        "suggested-action",
      ]
    }

    ScrolledWindow {
      hscrollbar-policy: never;
      vexpand: true;
      hexpand: true;

      Adw.PreferencesPage {
        Adw.PreferencesGroup {
          $BootcPageHeader page_header {
            margin-top: 24;
            icon-name: "channel-secure-symbolic";
            title: _("Disk Encryption");
            subtitle: _("Choose how to protect the data on your disk.");
          }
        }

        // Shown instead of the choices below when the disk step keeps an existing install's files.
        Adw.PreferencesGroup group_keep_encryption {
          visible: false;

          Adw.ActionRow keep_encryption_row {
            title: _("Keeping the existing encryption");
            subtitle: _("The disk stays encrypted with its current password, and TPM2 unlock stays as it was.");
          }
        }

        Adw.PreferencesGroup group_encryption_choice {
          // Subtitles are branding copy, set in encryption.py: this row is
          // the luks-passphrase choice, the TPM row tpm2-luks-passphrase.
          Adw.ActionRow encryption_row {
            title: _("Encrypt this disk");

            [suffix]
            Switch use_encryption_switch {
              valign: center;
              active: true;
            }

            activatable-widget: use_encryption_switch;
          }

          Adw.PasswordEntryRow encryption_pass_entry {
            title: _("Password");
            sensitive: bind use_encryption_switch.active;
          }

          Adw.PasswordEntryRow encryption_pass_entry_confirm {
            title: _("Confirm Password");
            sensitive: bind use_encryption_switch.active;
          }

          Label strength_label {
            visible: false;
            halign: start;
            margin-start: 12;
            margin-top: 4;
            margin-bottom: 4;
          }

          // Hidden, not just defaulted off, when there is no TPM 2.0
          // (shared/tpm/README.md): encryption.py sets `visible` from
          // Systeminfo.has_tpm2(), as the other four frontends do.
          Adw.ActionRow tpm2_row {
            visible: false;
            title: _("Use hardware-backed encryption");
            sensitive: bind use_encryption_switch.active;

            [suffix]
            Switch tpm2_switch {
              valign: center;
            }

            activatable-widget: tpm2_switch;
          }
        }
      }
    }
  }
}
